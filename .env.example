# Copy to .env.local and fill in.
DASHBOARD_PASSCODE=change-me
SESSION_SECRET=a-long-random-string-at-least-32-characters
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# MongoDB connection (Atlas or self-hosted). Content, history and uploads live here.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Vercel Blob (dashboard image/PDF uploads). Created in Vercel → Storage → Blob; connecting the
# store to the project adds this automatically. Leave unset locally to fall back to MongoDB GridFS.
BLOB_READ_WRITE_TOKEN=
